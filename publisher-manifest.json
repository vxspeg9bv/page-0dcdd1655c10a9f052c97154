nt: \"\";position: absolute;left: 9px;top: 30px;bottom: 10px;width: 1px;background: rgba(255, 253, 248, .18)}\n\n    .step h3 {margin: 0 0 7px;color: var(--ivory);font-size: 17px}\n\n    .step p {margin: 0;color: rgba(247, 241, 231, .65);font-size: 14px}\n\n    .notice {margin-top: 24px;padding: 18px 20px;border-left: 3px solid var(--gold);color: rgba(247, 241, 231, .65);background: rgba(255, 255, 255, .035);font-size: 13px}\n\n    .faq-groups {display: grid;grid-template-columns: repeat(2, 1fr);gap: 24px}\n\n    .faq-group {padding: 30px;border-left: 4px solid var(--wine-soft);background: var(--paper)}\n\n    .faq-group:nth-child(2) {border-left-color: var(--gold)}\n\n    .faq-group h3 {margin: 0 0 24px;color: var(--wine-dark);font-family: Georgia, \"Songti SC\", serif;font-size: 24px}\n\n    details {border-top: 1px solid var(--line)}\n\n    details:last-child {border-bottom: 1px solid var(--line)}\n\n    summary {position: relative;padding: 20px 34px 20px 0;color: var(--ink);cursor: pointer;font-size: 14px;font-weight: 700;list-style: none}\n\n    summary::-webkit-details-marker {display: none}\n\n    summary::after {content: \"+\";position: absolute;right: 4px;top: 15px;color: var(--wine);font-family: Georgia, serif;font-size: 23px;font-weight: 400}\n\n    details[open] summary::after {content: \"−\"}\n\n    details p {margin: -4px 0 22px;color: var(--muted);font-size: 14px}\n\n    .faq-note {margin: 32px 0 0;color: var(--muted);font-size: 13px;text-align: center}\n\n    .closing {padding: 82px 0 140px;color: var(--ivory);background: var(--wine)}\n\n    .closing-inner {display: flex;align-items: end;justify-content: space-between;gap: 40px}\n\n    .closing h2 {max-width: 720px;margin: 0;font-family: Georgia, \"Songti SC\", serif;font-size: clamp(30px, 4.6vw, 52px);line-height: 1.25}\n\n    .closing p {max-width: 620px;margin: 20px 0 0;color: rgba(247, 241, 231, .72);font-size: 14px}\n\n    .closing .button {flex: 0 0 auto;color: var(--wine-dark);background: var(